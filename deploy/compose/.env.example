# Image tag to run. Pin a version in production, e.g. 0.1.0.
SENTINEL_VERSION=latest
# Host port for the dashboard, bound to 127.0.0.1 only.
SENTINEL_PORT=9477
# The StakeSquid stack's network. Compose names it <directory>_monitor-net.
STACK_NETWORK=graphprotocol-mainnet-docker_monitor-net

# The container sees this whole file. GRAPH_SENTINEL_SECTION__KEY overrides that key in the TOML.

# tap-agent's database (postgres-agent in the StakeSquid stack), read-only role. Turns on the REO meter.
#GRAPH_SENTINEL_SOURCES__INDEXER_POSTGRES_URL=postgres://sentinel_ro:change-me@postgres-agent:5432/your_agent_db_name
# graph-node's database, optional: adds local columns to the candidates list.
#GRAPH_SENTINEL_SOURCES__POSTGRES_URL=postgres://sentinel_ro:change-me@postgres:5432/your_graphnode_db_name

# A gateway API key from Subgraph Studio, for the network subgraph.
GRAPH_API_KEY=
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Server Settings > Integrations > Webhooks > Copy Webhook URL.
DISCORD_WEBHOOK_URL=
# Log level, e.g. graph_sentinel=debug,warn
RUST_LOG=graph_sentinel=info,warn
